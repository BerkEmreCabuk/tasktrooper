# Browser development against a local server. Copy to .env.local.
#
# Inside the desktop app neither of these is read: the shell states its own API
# base (the port it started the server on) and its own token.

# Where API calls go. Empty means "same origin, no prefix", which the Vite dev
# server proxies to http://localhost:8085. Set it to reach a server elsewhere.
VITE_API_BASE=http://127.0.0.1:8085

# Bearer token for that server. Must match its SERVER_API_KEY. There is no
# sign-in screen: with no token the app renders a configuration error.
VITE_API_KEY=local-dev-key
